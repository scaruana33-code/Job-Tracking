# systemd unit for the cadence scheduler (bare-metal, no Docker).
#   sudo cp deploy/job-tracker-scheduler.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now job-tracker-scheduler
#   journalctl -u job-tracker-scheduler -f
[Unit]
Description=Job-Search Analytics cadence scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stephen
WorkingDirectory=/opt/job_tracker
EnvironmentFile=/opt/job_tracker/.env
ExecStart=/opt/job_tracker/.venv/bin/python -m job_tracker.scheduler
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
