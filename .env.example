# ---- Excel tracker (read + write-back) ------------------------------------
TRACKER_XLSX=data/Executive_Job_Search_Tracker.xlsx
TRACKER_WRITE_BACK=1

# ---- Relational database sources (leave blank to skip) --------------------
# SQLAlchemy URLs, e.g.
#   postgresql+psycopg2://user:pass@host:5432/dbname
#   mysql+pymysql://user:pass@host:3306/dbname
#   sqlite:///data/manual_log.db
ATS_DB_URL=
MANUAL_DB_URL=

# ---- Warehouse (unified fact table) ---------------------------------------
WAREHOUSE_URL=sqlite:///data/job_tracker.db

# ---- Gmail (disabled by default; set to 1 to enable) ----------------------
GMAIL_ENABLED=0
GMAIL_CREDENTIALS=credentials.json
GMAIL_TOKEN=token.json
GMAIL_QUERY=newer_than:120d (application OR interview OR "thank you for applying" OR offer OR recruiter OR "next steps")
NOTIFY_EMAIL=you@gmail.com

# ---- LinkedIn (official data export CSV; NO scraping) ---------------------
LINKEDIN_EXPORT=data/linkedin_job_applications.csv

# ---- Refresh cadence (cron-ish) -------------------------------------------
REFRESH_DOW=mon
REFRESH_HOUR=7
REFRESH_MIN=0
TZ=America/New_York
